  "contracts": {
    "purity": "No DOM/browser/JS interpreter/Canvas/native values and no runtime .local dependency. FrozenMap/FrozenArray are immutable tuple subclasses distinguishing empty object and array. thaw_value is the supported recursive decoder.",
    "preprocessing": "raw -> CRLF normalization -> HTML attribute quote normalization -> YAML frontmatter -> directive detection/config merge -> directive removal -> whole-line comments -> leading trim. cleaned boundaries map back to raw Python boundaries, then raw UTF16/line/column.",
    "layers": "default/site/frontmatter/directive preserved as frozen pure tuples. Frontmatter+directive lodash merge differs from assignWithDepth source bounded object merge/array union. Site secure keys protect in-document overrides recursively.",
    "labels": "raw_label keeps inner source markup/custom # entities; label_kind differentiates stripped outer Markdown quotes/backticks; label uses shared pure sanitize_markup and old plain whitespace normalization. C labels owns final single entity decode/markup measurement.",
    "defaults": "Diagram default redux-color/neo beats global default/classic. Effective Recursive14 theme font differs from site Trebuchet16; explicit root fontFamily bridges, root fontSize does not. RootTD/LR and existing F012 grammar remain.",
    "dompurify": "effective site option mapping frozen; dompurify_provided distinguishes explicit empty {} from missing/null. In-document dompurifyConfig is dropped by pinned default config-key sanitizer."
  },
  "mechanicalEvidence": "test-runs/F01.3-parser-source-final-20261105T014503Z-ee62f2c7/run.json",
  "behaviorExecuted": false,
  "risksAndDeferred": [
    {
      "id": "yaml-schema-conformance",
      "status": "requires_independent_source_tests",
      "detail": "Pinned js-yaml4.3 numeric cases/finite bounds/JS-number rounding and block keep sentinel repaired with independent regression tests. Reader implements safe JSON-schema flow/block collections, aliases, tags and folded/quoted multiline. No claim of universal js-yaml conformance; complex object-key and cyclic alias semantic gaps remain explicit rather than importing a runtime dependency."
    },
    {
      "id": "theme-closure",
      "status": "scope_boundary",
      "detail": "All 11 registered themes implement constructor/update statements reachable by flowchart fields; non-flowchart theme calculations and loops belong to deferred diagram families."
    },
    {
      "id": "null-theme",
      "status": "source_semantics_preserved",
      "detail": "String null is not a registry theme: initialize uses fallback default variables, while scoped null keeps inherited variables rather than deleting CSS styles."
    },
    {
      "id": "neo-shadow-source",
      "status": "corrected_analysis_and_targeted_regression_passed",
      "detail": "The original string is valid: balanced two function parentheses with trailing CSS declaration semicolon. Original literal is preserved. Scalar parser ignores that terminator, while styles owner interprets the complete source filter. Earlier malformed interpretation was wrong."
    },
    {
      "id": "empty-comment",
      "status": "source_question",
      "detail": "cleanupComments source requires content after %% but previous slice accepts an empty whole-line marker. Source-negative empty-comment EOF coverage remains to establish exact combined cleanup/grammar effect."
    },
    {
      "id": "color-format",
      "status": "requires_independent_source_tests",
      "detail": "CSS colors and Khroma channel/luminance operations are ported as pure values. Canonical CSS HSL formatting may differ while channels match; test colors semantically as well as source string where observable."
    },
    {
      "id": "f014-dagre",
      "status": "deferred_by_user",
      "detail": "Full grammar style/class/click/link variants/new @{shape} metadata, math/icons/images/resources, handDrawn and Dagre are not implemented in F01.3. Unsupported branches fail explicitly."
    }
  ],
