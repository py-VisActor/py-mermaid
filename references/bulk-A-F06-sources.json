  "sourceImplemented": {
    "mindmap": [
      "Jison NODE/NSTR/NSTR2 lexical shapes and quoted/multiline labels",
      "DB base-indent normalization, nearest lower-indented parent, one-root error and source ordered numeric IDs",
      "node classes/icon metadata, branch/depth section colors, effective source styles and all seven DB shape categories",
      "Root layout presence only (_explicitRootLayout): source force-selects COSE when root layout missing, explicit registered layout honored",
      "Flat-tree radial/FR-grid spring CoSE1 actual path with cooling/convergence and source findCenterOfTree mutating-list behavior",
      "Tidy2 first/second walks, extremes/threads/IYL, dual-horizontal adapter, shape-aware terminal routes"
    ],
    "treeView": [
      "Langium indent stack and virtual root directory",
      "Box-drawing preprocessing standard/heavy characters, spacing/tabs/line offsets",
      "Quoted names/directories, class/icon/description annotations and repeated-field last assignment",
      "Source preorder rows, connector trunks, description right alignment, highlight pass growth",
      "Built-in file/folder SVG and explicit resource IDs/config filename/extension icon policy"
    ]
  },
  "sourceAnomalies": [
    "Current unified mindmap icon metadata has no icon glyph consumer. Only addSvgBackground is consumed; the old svgDraw icon renderer is inactive. Preserve metadata and SVG background, do not invent a resource glyph/40px footprint. P2 official check required.",
    "CoSE validateLayoutData requires rootNode and config; public native CoSE gate is restricted to effective mindmap config, not generic unrelated graphs",
    "Tidy source does not require rootNode: derives first parentless node or first node from edges. Cyclic recursion receives explicit native safety diagnosis, not fake success",
    "Mindmap cloud/bang source node.intersect is rectangular; tidy adapter separately classifies them as round, preserve that adapter-specific behavior",
    "No source diagram title paint consumer in current mindmap/treeView renderers; metadata is retained without inventing visible titles"
  ],
  "remainingVerification": [
    "COSE/tidy numerical positions and functional nonoverlap/readability on all source branches",
    "Quoted/Unicode whitespace and source error remapping after box glyph preprocessing",
    "Theme styles/class selectors, exact active icon no-glyph source anomaly and SVG background"
  ],
