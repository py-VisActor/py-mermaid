  "sourceImplemented": {
    "block": [
      "Actual Jison whitespace token grammar, quotes, shape delimiter combinations, edges/text links, composite named/auto IDs, spaces and width spans",
      "DB first-placement identity aggregation, later shape/label updates, style/classDef/class, columns and preorder composite palette",
      "Recursive equal-cell getMaxChildSize/setBlockSizes and row-height layoutBlocks with clamp of filled columns",
      "All classic node shape rendering; 15 nonempty direction combinations and point fallback from source blockArrow.ts factories",
      "Source straight midpoint relationship path, source marker/thickness/pattern semantics, unknown endpoint rendering guard"
    ],
    "packet": [
      "Langium ranges/+bits/STRING and title/accessibilities",
      "Contiguity/reversed/zero-size validation, max10000 rows and true row splitting",
      "Bits per row, bit width, gaps, showBits extra10 paddingY, ascending/descending mirror and endpoint numbers",
      "Source packet-only style defaults and themeVariables.packet overrides, bottom-centered title"
    ],
    "kanban": [
      "Jison same node shape/string lexical categories, indentation-defined flat sections and all items assigned last section",
      "Multiline/single-line YAML JSON_SCHEMA metadata label/ticket/assigned/priority/icon, decorator metadata and lowercase shape gate",
      "Measured fixed-width columns, max header height and dynamic section heights",
      "Actual ticket/assigned rows and priority colors; handDrawn priority branch follows source exclusion; metadata icon has no kanbanItem icon glyph consumer"
    ],
    "architecture": [
      "Full Langium group/service/junction/edge/align grammar, quoted icon text and title conversion",
      "Source populateDb order groups then services then junctions, duplicate-ID/parent/edge/group-boundary/align validation",
      "DB directional adjacency overwrite/BFS spatial maps, group alignment split/merge and explicit hint precedence",
      "Renderer relative placements/hint chains and contradiction diagnostics",
      "Private fCoSE proof pipeline: optional graph-distance Nystr\u00f6m spectral initialization, seeded mulberry32, symmetric numeric eigendecomposition, compound rectangles/springs/repulsion/gravity, constraints and cooling/convergence",
      "Source built-in architecture SVGs, explicit icon resources, service iconText native HTML rich runs/line clamp/ellipsis/clip, labels/groups, junction invisible footprint, orthogonal bend routes and direction-specific arrows"
    ]
  },
  "sourceAnomalies": [
    "Block generated random IDs are replaced with request-local stable private IDs; identity/topology/placement preserved, no global mutable counter",
    "Block grammar declares several lexer tokens without reachable productions (linkStyle/interpolate and MD_STR node labels); no fake support claimed",
    "Architecture same-direction (LL/RR/TT/BB) edges omitted from DB adjacency/BFS but are still source edge records, not newly rejected",
    "Architecture group endpoint IDs pass preliminary registration test but fixed DB then dereferences nodes.get(id).in and fails; explicit native upstream endpoint diagnosis",
    "Architecture no independent layout selection dispatcher exists: active source always fCoSE; root layout flag is not silently substituted for ELK",
    "Architecture source runs its proof solver twice around bend adjustment; native computes identical final orthogonal route geometry directly after its local proof simulation",
    "Current active kanban does not draw stored metadata icon glyph; classes stored by decorateNode are not copied into getData classes and are not invented as new styling behavior"
  ],
  "numericPortDifferences": [
    "Spectral PHI is symmetric: native Jacobi eigendecomposition replaces source host SVD while retaining signed singular regularization/Nystr\u00f6m/power iteration formulas; coordinates are not asserted identical",
    "Constraint owner uses pure union-find alignment + DAG longest-path/centroid projection, retaining alignment and relative inequalities rather than source Cytoscape dummy-node object bookkeeping",
    "Compound proof simulation keeps all real leaves rather than reproducing host pruning/regrowth data-structure optimizations; static hierarchy/forces/constraint functionality requires independent P2/P3 verification",
    "Disconnected childless tiling uses actual measured rectangular cells and source10px gaps; exact source row-minimization heuristic and final host translation are not claimed pixel-identical"
  ],
  "remainingVerification": [
    "All grammar accepted/rejected source cases, original UTF16 positions and state isolation",
    "Full fCoSE compound/randomize/seed/constraint functional validation and residual-overlap/readability against official captures",
    "Block all spans/columns/shape combinations and source aggregate-ID/style edge cases",
    "Packet range and empty diagrams, kanban YAML and field geometry/priority/handDrawn branches",
    "All Canvas clip/rotation/resource and SVG/PDF output paths remain unexecuted in P1"
  ],
