      "semantics": "Enumerated type defaults; applicable boolean states; newline/ASCII trimming; date/time validity; number validation; range min/max/default/step with positive tie break; empty selected file list; raw safe image src/alt attributes. submit/reset IDL value stays empty when absent; layout supplies default caption only when attribute absent."
    },
    {
      "id": "selection",
      "semantics": "Option label/value/ASCII whitespace, optgroup disabled/group label, multiple versus single-last-selected, size1 first-enabled fallback, no fallback for larger listboxes."
    },
    {
      "id": "textarea",
      "semantics": "Decoded RCDATA payload, literal descendant-token reconstruction, CRLF/CR to LF and single initial LF removal; placeholder remains separate attribute. Mermaid text-versus-Markdown newline preprocessing belongs to root rich."
    },
    {
      "id": "meter-progress",
      "semantics": "Finite HTML numeric attribute parsing; min/max/value clamping; meter fraction and low/high/optimum attrs; missing progress value gives indeterminate fraction=None."
    },
    {
      "id": "cross-control",
      "semantics": "Tree/form-owned case-sensitive nonempty radio-name groups, last checked wins including disabled inputs; nested fieldset disabling with first direct legend exemption; explicit form override when sanitizer allows it."
    },
    {
      "id": "safe-markup",
      "semantics": "Full118 HTML attrs from fixed DOMPurify bundle, including checked/selected/disabled/readonly/multiple/rows/cols/label/placeholder/min/max/low/high/optimum/step; existing custom allow/forbid and URI checks still apply; background URL filtered as well."
    },
    {
      "id": "budgets",
      "semantics": "20,000 capture/normalizer nodes/events and256 nesting; pure immutable output; request-local state; no runtime DOM/Node/JS/media/network/events."
    }
  ],
