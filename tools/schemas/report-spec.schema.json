{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "py-mermaid-render-report-spec/v1",
  "type": "object",
  "required": ["schema", "scope", "title", "final", "oracle", "fixtures", "profiles"],
  "properties": {
    "schema": {"const": "py-mermaid-render-report-spec/v1"},
    "scope": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "title": {"type": "string", "minLength": 1},
    "final": {"type": "string", "minLength": 1},
    "oracle": {"type": "string", "minLength": 1},
    "fixtures": {"type": "string", "minLength": 1},
    "template": {"type": "string"},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}},
    "defaultCase": {"type": "string"},
    "caseTitles": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
